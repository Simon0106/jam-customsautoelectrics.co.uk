<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Jam Customs | Auto Electrics & Vehicle Security | Poole</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <script>
        tailwind.config = {
            theme: {
                extend: {
                    colors: {
                        darkbg: '#0a0a0c',
                        cardbg: '#131318',
                        accent: '#a855f7', /* Electric Purple */
                        accentglow: '#c084fc',
                        neonblue: '#06b6d4'
                    }
                }
            }
        }
    </script>
</head>
<body class="bg-darkbg text-gray-100 font-sans selection:bg-accent selection:text-white">

    <!-- Top Bar -->
    <div class="bg-black/80 border-b border-gray-800 text-xs py-2 px-4 text-gray-400">
        <div class="max-w-7xl mx-auto flex flex-col sm:flex-row justify-between items-center gap-2">
            <div class="flex items-center gap-4">
                <span><i class="fas fa-map-marker-alt text-accent mr-1"></i> Poole, Dorset & Surrounding Areas</span>
                <span><i class="fas fa-clock text-accent mr-1"></i> Mon - Fri: 8:30 AM - 5:30 PM</span>
            </div>
            <div>
                <a href="https://www.facebook.com/custom.ride.one.stop.shop" target="_blank" class="hover:text-accent transition"><i class="fab fa-facebook text-base"></i> Visit Facebook Page</a>
            </div>
        </div>
    </div>

    <!-- Navigation -->
    <nav class="sticky top-0 z-50 bg-darkbg/95 backdrop-blur border-b border-gray-800">
        <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 h-20 flex items-center justify-between">
            <div class="flex items-center gap-3">
                <img src="jamlogo.png" alt="Jam Customs Logo" class="h-12 w-auto object-contain">
                <span class="text-xl font-black tracking-wider uppercase bg-gradient-to-r from-white via-gray-200 to-accent bg-clip-text text-transparent">Jam Customs</span>
            </div>
            <div class="hidden md:flex items-center gap-8 font-medium text-sm">
                <a href="#services" class="hover:text-accent transition">Services</a>
                <a href="#about" class="hover:text-accent transition">About</a>
                <a href="#gallery" class="hover:text-accent transition">Gallery</a>
                <a href="#contact" class="bg-accent hover:bg-accentglow text-white px-5 py-2.5 rounded-lg font-bold shadow-lg shadow-accent/25 transition">Book / Enquire</a>
            </div>
        </div>
    </nav>

    <!-- Hero Section -->
    <header class="relative overflow-hidden py-24 lg:py-32 border-b border-gray-800">
        <div class="absolute inset-0 bg-[radial-gradient(circle_at_top_right,_var(--tw-gradient-stops))] from-accent/15 via-transparent to-transparent pointer-events-none"></div>
        <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 relative z-10 text-center">
            <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-accent/10 border border-accent/30 text-accent text-xs font-semibold uppercase tracking-wider mb-6">
                <i class="fas fa-bolt">></i> Poole's Specialist Auto Electrics & Security
            </div>
            <h1 class="text-4xl sm:text-6xl font-black tracking-tight uppercase mb-6">
                Precision Auto Electrics & <span class="text-accent">Vehicle Security</span>
            </h1>
            <p class="max-w-2xl mx-auto text-gray-400 text-lg mb-10">
                Professional diagnostics, custom wiring, immobilisers, tracking systems, and advanced electrical upgrades based in Poole. 
            </p>
            <div class="flex flex-col sm:flex-row justify-center gap-4">
                <a href="#contact" class="bg-accent hover:bg-accentglow text-white font-bold px-8 py-4 rounded-xl shadow-lg shadow-accent/30 transition text-center">Get a Free Quote</a>
                <a href="https://www.facebook.com/custom.ride.one.stop.shop" target="_blank" class="border border-gray-700 hover:border-accent hover:text-accent font-bold px-8 py-4 rounded-xl transition text-center flex items-center justify-center gap-2"><i class="fab fa-facebook-f"></i> View Recent Work</a>
            </div>
        </div>
    </header>

    <!-- Services Section -->
    <section id="services" class="py-20 bg-cardbg/50">
        <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
            <div class="text-center max-w-3xl mx-auto mb-16">
                <h2 class="text-3xl font-black uppercase tracking-tight mb-4">Our Core Services</h2>
                <p class="text-gray-400">Expert electrical solutions engineered for reliability, security, and peak performance.</p>
            </div>
            <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
                <!-- Service 1 -->
                <div class="bg-cardbg border border-gray-800 p-8 rounded-2xl relative group hover:border-accent transition">
                    <div class="w-14 h-14 rounded-xl bg-accent
